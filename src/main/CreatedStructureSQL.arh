-- ═══ 2. Функция доступа ═══
CREATE OR ALTER FUNCTION dbo.fn_rag_has_full_access (@login nvarchar(128))
RETURNS bit
WITH SCHEMABINDING
AS
BEGIN
    RETURN CASE WHEN EXISTS
        (SELECT 1 FROM dbo.rag_full_access_users
         WHERE domain_login = LOWER(@login) AND is_active = 1)
    THEN 1 ELSE 0 END;
END
GO

-- ═══ 3. Процедура выборки (document_id убран — идентификатор document_guid) ═══
CREATE OR ALTER PROCEDURE dbo.rag_get_visible_documents
    @user_login  nvarchar(128),
    @user_org_le nvarchar(255) = NULL,
    @search      nvarchar(400) = NULL,
    @only_kind   nvarchar(50)  = NULL
AS
BEGIN
    SET NOCOUNT ON;

    DECLARE @full bit = dbo.fn_rag_has_full_access(@user_login);  -- один раз!

    SELECT
        r.document_guid,
        r.doc_name,
        r.doc_number,
        r.project_number,
        r.org_le,
        r.classifier,
        r.kind,
        r.status,
        r.indexed_at,
        CASE WHEN @full = 1 AND r.org_le IS NOT NULL
                  AND r.org_le <> ISNULL(@user_org_le, N'~~~')
             THEN 1 ELSE 0 END AS is_cross_le_access
    FROM dbo.rag_document_ref r
    WHERE r.is_deleted = 0
      AND (@only_kind IS NULL OR r.classifier = @only_kind)
      -- ═══ контроль доступа ═══
      AND ( @full = 1
            OR r.org_le IS NULL
            OR (@user_org_le IS NOT NULL AND r.org_le = @user_org_le) )
      -- ═══ поиск ═══
      AND ( @search IS NULL
            OR r.doc_name   LIKE '%' + @search + '%'
            OR r.doc_number LIKE '%' + @search + '%' )
    ORDER BY r.src_modified_at DESC;
END
GO

-- ═══ 3.2 Синхронизауия ОРД  ═══
SET ANSI_NULLS ON
GO
SET QUOTED_IDENTIFIER ON
GO
CREATE OR ALTER PROCEDURE [dbo].[rag_sync_ord_sto]
AS
BEGIN
    SET NOCOUNT ON;
    SET XACT_ABORT ON;

    DECLARE @dt  datetime = GETDATE();
    DECLARE @ins int;
    DECLARE @upd int;

    IF OBJECT_ID('tempdb..#rag_src') IS NOT NULL DROP TABLE #rag_src;

    BEGIN TRY
        BEGIN TRAN;

        -- ── Шаг 1: материализуем выборку во временную таблицу ──────────────
        ;WITH raw AS
        (
            SELECT
                doc_main.InstanceID    AS document_guid,
                v_files.FileID         AS row_id,
                doc_main.Name          AS doc_name,
                doc_main.Number        AS doc_number,
                doc_main.ProjectNumber AS project_number,
                doc_main.NumeratorName AS numerator_name,
                TypeDocRow.Name        AS kind,
                le.Name                AS org_le,
                dates.CreationDateTime AS src_created_at,
                dates.ChangeDateTime   AS src_modified_at,
                ROW_NUMBER() OVER (PARTITION BY doc_main.InstanceID, v_files.FileID
                                   ORDER BY (SELECT NULL)) AS rn,
                COUNT(*) OVER (PARTITION BY doc_main.InstanceID) AS file_count
            FROM dbo.[dvtable_{91b2c5f7-9324-4cef-9afe-a457c8310f06}] doc_sys WITH (NOLOCK)
            INNER JOIN dbo.[dvtable_{30eb9b87-822b-4753-9a50-a1825dca1b74}] doc_main WITH (NOLOCK)
                ON doc_sys.InstanceID = doc_main.InstanceID
            INNER JOIN [dvtable_{1B1A44FB-1FB1-4876-83AA-95AD38907E24}] TypeDocRow WITH (NOLOCK)
                ON doc_main.Type = TypeDocRow.RowID
            LEFT JOIN dbo.[dvtable_{7473f07f-11ed-4762-9f1e-7ff10808ddd1}] le WITH (NOLOCK)
                ON le.RowID = doc_main.LegalEntity
            INNER JOIN dbo.[dvsys_instances_date] dates WITH (NOLOCK)
                ON dates.InstanceID = doc_sys.InstanceID
            INNER JOIN dbo.[dvtable_{521B4477-DD10-4F57-A453-09C70ADB7799}] stat WITH (NOLOCK)
                ON stat.RowID = doc_sys.State
            INNER JOIN dbo.[dvtable_{DA37CA71-A977-48E9-A4FD-A2B30479E824}] state_local WITH (NOLOCK)
                ON state_local.ParentRowID = stat.RowID AND state_local.LocaleID = 1049
            INNER JOIN [dbo].[dvtable_{a6fa8baf-2ea4-4071-aa3e-5c4e71646a90}] doc_files WITH (NOLOCK)
                ON doc_files.InstanceID = doc_main.InstanceID
            INNER JOIN [dbo].[dvtable_{f831372e-8a76-4abc-af15-d86dc5ffbe12}] v_files WITH (NOLOCK)
                ON v_files.InstanceID = doc_files.FileId
            INNER JOIN dbo.[dvsys_files] files WITH (NOLOCK)
                ON files.FileID = v_files.FileID
            INNER JOIN dbo.[dvsys_binaries] file_binaries WITH (NOLOCK)
                ON file_binaries.ID = files.BinaryID
            WHERE doc_sys.Kind = 'D91AE4FB-B782-43C6-9980-E490EF21E3A9'
              AND doc_main.Name LIKE '%СТО №%'
              AND state_local.Name IN ('В архиве', 'Зарегистрирован', 'Исполнен')
        )
        SELECT
            document_guid, row_id, doc_name, doc_number, project_number,
            numerator_name, kind, org_le, src_created_at, src_modified_at, file_count
        INTO #rag_src
        FROM raw
        WHERE rn = 1;

        -- ── Шаг 2: INSERT новых записей ────────────────────────────────────
        INSERT INTO dbo.rag_document_ref
            (document_guid, row_id, doc_name, doc_number, project_number, numerator_name,
             org_le,
             classifier, kind, is_deleted, status, version,
             src_created_at, src_modified_at, file_count, file_sig,
             sync_at, claimed_at, indexed_at, content_hash, error_msg, retry_count, updated_at)
        SELECT
            s.document_guid, s.row_id, s.doc_name, s.doc_number, s.project_number, s.numerator_name,
            s.org_le,
            'СТО', s.kind, 0, 'N', 1,
            s.src_created_at, s.src_modified_at, s.file_count, NULL,
            @dt, NULL, NULL, NULL, NULL, 0, @dt
        FROM #rag_src s
        WHERE NOT EXISTS
        (
            SELECT 1
            FROM dbo.rag_document_ref r WITH (UPDLOCK, HOLDLOCK)
            WHERE r.document_guid = s.document_guid
              AND r.row_id = s.row_id
        );

        SET @ins = @@ROWCOUNT;

        -- ── Шаг 3: дозаполнить org_le для уже существующих записей ──────────
        UPDATE r
           SET r.org_le = s.org_le,
               r.updated_at = @dt
        FROM dbo.rag_document_ref r
        INNER JOIN #rag_src s
            ON  r.document_guid = s.document_guid
            AND r.row_id = s.row_id
        WHERE r.org_le IS NULL
          AND s.org_le IS NOT NULL;

        SET @upd = @@ROWCOUNT;

        COMMIT;
    END TRY
    BEGIN CATCH
        IF @@TRANCOUNT > 0 ROLLBACK;
        THROW;
    END CATCH;

    DROP TABLE #rag_src;

    -- счётчик (виден при ручном запуске и пишется в историю задания Agent)
    RAISERROR('RAG ОРД СТО: вставлено %d строк, org_le обновлено %d строк', 0, 1, @ins, @upd) WITH NOWAIT;
END
GO