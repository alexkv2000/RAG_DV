CREATE TABLE [dbo].[rag_document_ref](
	[document_guid] [uniqueidentifier] NOT NULL,
	[doc_name] [nvarchar](512) NULL,
	[doc_number] [nvarchar](128) NULL,
	[project_number] [nvarchar](128) NULL,
	[numerator_name] [nvarchar](128) NULL,
	[classifier] [nvarchar](1024) NULL,
	[kind] [nvarchar](128) NULL,
	[is_deleted] [bit] NOT NULL,
	[status] [char](1) NOT NULL,
	[version] [int] NOT NULL,
	[src_created_at] [datetime2](3) NULL,
	[src_modified_at] [datetime2](3) NULL,
	[file_count] [int] NULL,
	[file_sig] [int] NULL,
	[sync_at] [datetime2](3) NOT NULL,
	[claimed_at] [datetime2](3) NULL,
	[indexed_at] [datetime2](3) NULL,
	[content_hash] [binary](32) NULL,
	[error_msg] [nvarchar](2048) NULL,
	[retry_count] [int] NOT NULL,
	[updated_at] [datetime2](3) NOT NULL,
	[row_id] [uniqueidentifier] NOT NULL,
	[org_le] [nvarchar](255) NULL,
 CONSTRAINT [PK_rag_document_ref] PRIMARY KEY CLUSTERED
(
	[document_guid] ASC,
	[row_id] ASC
)WITH (PAD_INDEX = OFF, STATISTICS_NORECOMPUTE = OFF, IGNORE_DUP_KEY = OFF, ALLOW_ROW_LOCKS = ON, ALLOW_PAGE_LOCKS = ON, OPTIMIZE_FOR_SEQUENTIAL_KEY = OFF) ON [SYSTEM]
) ON [SYSTEM]
