CREATE TABLE dbo.rag_full_access_users
(
    domain_login  nvarchar(128)  NOT NULL,
    display_name  nvarchar(256)  NULL,
    granted_at    datetime       NOT NULL CONSTRAINT DF_rag_fau_granted DEFAULT GETDATE(),
    granted_by    nvarchar(128)  NULL,
    is_active     bit            NOT NULL CONSTRAINT DF_rag_fau_active DEFAULT 1,
    CONSTRAINT PK_rag_full_access_users PRIMARY KEY CLUSTERED (domain_login)
);
